{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>autobutler-org/renovate-config"],
  "enabledManagers": ["npm", "github-actions", "custom.regex"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Allow TypeScript major updates in their own pull request.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "enabled": true
    },
    {
      "description": "Bump the pinned Quark commit in its own pull request.",
      "matchDepNames": ["autobutler-org/quark"],
      "matchManagers": ["custom.regex"],
      "groupName": null,
      "commitMessageTopic": "Quark e2e ref",
      "semanticCommitType": "test",
      "semanticCommitScope": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the autobutler-org/quark commit pinned as the QUARK_REF fallback in the e2e workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "QUARK_REF: \\$\\{\\{ vars\\.QUARK_REF \\|\\| '(?<currentDigest>[a-f0-9]{40})' \\}\\}"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/autobutler-org/quark",
      "depNameTemplate": "autobutler-org/quark",
      "currentValueTemplate": "main"
    }
  ]
}
