{
  "name": "browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that fills logins from the password vault on your Quark",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:e2e": "npm run build && node e2e/smoke.mjs",
    "package": "npm run build && cd dist && zip -qr ../quark-vault.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
